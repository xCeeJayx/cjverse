{
  "name": "@cjverse/asset-pipeline",
  "version": "0.1.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --watch --dts",
    "lint": "eslint src/",
    "clean": "rimraf dist .turbo",
    "test": "vitest run",
    "generate:dry": "tsx scripts/generate-characters.ts --dry-run",
    "generate:sample": "tsx scripts/generate-characters.ts --sample",
    "generate:all": "tsx scripts/generate-characters.ts",
    "generate:characters": "tsx scripts/generate-characters.ts",
    "generate:prompts": "tsx scripts/generate-prompts.ts",
    "generate:catalogs": "tsx scripts/generate-prompt-catalogs.ts",
    "nano:sample": "tsx scripts/run-nano.ts --sample=4",
    "nano:run": "tsx scripts/run-nano.ts --resume"
  },
  "dependencies": {
    "@cjverse/game-logic": "workspace:*",
    "@napi-rs/canvas": "^1.0.9"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0",
    "vitest": "^5.0.2"
  }
}
